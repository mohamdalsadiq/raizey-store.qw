{
  "framework": null,
  "ignoreCommand": "if [ \"$VERCEL_PROJECT_ID\" = \"prj_CVjmTTwFlJ2ZPLMjlWgawcdmk5OZ\" ]; then exit 1; else exit 0; fi",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/checkout.html",
      "destination": "/checkout-v2.html",
      "permanent": false
    },
    {
      "source": "/admin-subcategories.html",
      "destination": "/admin-categories.html",
      "permanent": false
    },
    {
      "source": "/admin-catalog.html",
      "destination": "/admin-categories.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://*.supabase.co; media-src 'self' data: blob:; connect-src 'self' blob: data: https://*.supabase.co wss://*.supabase.co https://cdn.jsdelivr.net; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/:path*.:hash([a-f0-9]{12}).:ext",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/catalog.mjs": {
      "includeFiles": "api/templates/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/product.html",
      "destination": "/api/catalog?kind=product"
    },
    {
      "source": "/category.html",
      "destination": "/api/catalog?kind=category"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/catalog?kind=sitemap"
    }
  ]
}
