{
  "name": "meem-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node scripts/cors_check.mjs && node scripts/test_receipt_pipeline.mjs && node scripts/test_receipt_judge.mjs && node scripts/category_icons_check.mjs && node scripts/test_vendor_security.mjs && npm run test:maintenance",
    "test:edge": "node scripts/test_process_receipt_edge.mjs",
    "test:security": "node scripts/test_security_db.mjs",
    "lint": "node scripts/verify-build.mjs --syntax-only",
    "build": "node scripts/verify-build.mjs && node scripts/build-public.mjs",
    "typecheck": "deno check --node-modules-dir=manual supabase/functions/process-receipt/index.ts supabase/functions/chat-assistant/index.ts",
    "test:maintenance": "node scripts/test_maintenance_client.mjs && node scripts/test_receipt_scan_activity.mjs && node scripts/test_maintenance_db.mjs && npm run test:usage",
    "test:usage": "node scripts/test_receipt_usage_db.mjs",
    "test:seo": "node scripts/test_catalog_seo.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@phosphor-icons/core": "2.1.1",
    "@supabase/supabase-js": "2.118.0",
    "chart.js": "4.5.1",
    "deno": "2.9.6",
    "libphonenumber-js": "1.13.15",
    "swiper": "12.2.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.9.0"
}
